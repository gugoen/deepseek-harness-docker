#!/bin/sh
# Container entrypoint shim: run the supervisor with the image's Node runtime.
#
#   serve              start the DeepSeek Harness Web UI (the image CMD)
#   <command> [args]   execute any other command verbatim, so the same image
#                      works as a plain sandbox: `docker run --rm -it <image> bash`
set -eu

exec node /usr/local/lib/dsh-docker/entrypoint.mjs "$@"
