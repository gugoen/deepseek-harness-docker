# Copy to .env and adjust, then:
#   docker compose -f docker/docker-compose.yml up -d --build
#
# docker compose reads this file from the directory holding docker-compose.yml.

# ── model access ────────────────────────────────────────────────────────────
# Required for the agent to call the model. The Web UI itself boots without it.
DEEPSEEK_API_KEY=
# Optional OpenAI-compatible endpoint override.
DEEPSEEK_BASE_URL=

# ── networking ──────────────────────────────────────────────────────────────
# Host port published by Docker.
DSH_HOST_PORT=3080
# Container port the reverse proxy listens on.
DSH_EXPOSE_PORT=3080
# URL printed at startup and handed to the model as DSH_WEB_URL. Point it at the
# address you actually browse to, so the clickable link is correct.
# DSH_PUBLIC_URL=http://192.168.1.50:3080
DSH_PUBLIC_URL=
# Convenience alternative to DSH_PUBLIC_URL: an HTTP(S) URL is derived from this
# host and DSH_EXPOSE_PORT.
DSH_PUBLIC_HOST=

# ── workspace and storage ───────────────────────────────────────────────────
# Directory the agent works in. Defaults to the repository root (the parent of
# docker/). Point it at a dedicated directory to keep the container a true
# sandbox.
DSH_WORKSPACE=../

# ── python ──────────────────────────────────────────────────────────────────
# Mount a host virtual environment (see docker-compose.python.yml). Both must be
# absolute host paths that exist at the same path inside the container.
DSH_PYTHON_ROOT=
DSH_PYTHON_VENV=

# ── build ───────────────────────────────────────────────────────────────────
# npm registry used during the image build.
NPM_REGISTRY=https://registry.npmmirror.com
# Optional apt mirror root, e.g. https://mirrors.tuna.tsinghua.edu.cn
# Leave empty to use the base image's own Debian sources.
DEBIAN_MIRROR=
# Bake Python dependencies into the image instead of mounting them: a
# requirements file path inside the repository, and the index to fetch from.
PYTHON_REQUIREMENTS=
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
DSH_IMAGE=deepseek-harness-web:0.2.1-alpha.1
DSH_CONTAINER_NAME=dsh-web

# ── privacy ─────────────────────────────────────────────────────────────────
DSH_TELEMETRY_DISABLED=true
